  "title": "Bass Melody",
  "revision": "1",
  "status": "auditioned",
  "summary": "A weighty sequenced saw-and-sub bass with a short filter bite and a restrained melodic range.",
  "brain": {
    "firmware": "Le Controlleur",
    "version": "unknown",
    "mode": "Sequencer",
    "layout": "three-knobs-two-buttons",
    "settings": [
      "X/Y/Z are the upper knobs, left to right: X 40% tempo, Y 0% octave range, Z 50% randomness. Press A to run.",
      "Use internal clock. Scale, sequence length, swing and transpose were not recorded; the exact melody may differ."
    ]
  },
  "description": {
    "sound": [
      "A low saw carries the melody while its sub adds weight. Each short gate opens the amplitude envelope and pushes the filter into a compact, rounded bite."
    ],
    "setup": [
      "Connect the seven instrument cables and headphones. Leave ENV/VCA 1 CONTROL empty: the internal envelope connection opens the VCA.",
      "Start with output volume low. Select Sequencer mode, set Brain X/Y/Z, and press A. Tune VCO 1 into the bass range while it plays.",
      "Brain X 40%, Y 0%, Z 50%, Mixer IN3 35% and Filter CUTOFF 65% are confirmed settings. Other percentages are starting points; adjust by ear."
    ],
    "play": [
      "Use Brain X for tempo. Start with Y at minimum for the narrowest octave range; raise it gradually to explore wider pitch movement.",
      "Balance Mixer IN3 against IN1 for sub weight. Sweep Filter CV1 LEVEL around 55-65% to move from a tight thump to a short \"ow\"."
    ],
    "variations": [
      "Shorten ENV1 RELEASE for clipped notes, or raise it toward 25% for longer tails. Short Brain gates make release especially useful.",
      "Start cutoff at 65% and make small adjustments for brightness; lowering it too far can silence the bass. Add resonance gradually for more squelch; reduce it if a high whistle dominates."
    ]
  },
  "normalled_policy": "VCO 1 OUT -> Mixer IN1 and ENV/VCA 1 ENV OUT -> CONTROL remain internally connected. Mixer IN2 and IN4 are at zero; Filter CV2 is centered. Explicit audio cables connect mixer, filter, VCA and output.",
