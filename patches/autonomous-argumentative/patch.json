{
  "schema_version": 1,
  "id": "autonomous-argumentative",
  "title": "Autonomous Argumentative",
  "revision": "1",
  "status": "auditioned",
  "summary": "A self-running stream of short electronic chirps, stepped whistles, and nervous pitch warbles inspired by an argumentative little service robot.",
  "brain": {
    "firmware": "Le Controlleur",
    "version": "v1.4 (target; confirm installed)",
    "mode": "Sequencer",
    "layout": "three-knobs-two-buttons",
    "settings": [
      "X/Y/Z are upper knobs left to right; A/B are lower buttons. Press A to run.",
      "X: 45% tempo. Keep above minimum because minimum selects external sync.",
      "Y: 65% octave range for wide pitch jumps. Z: 55% randomness for an irregular conversation.",
      "OUT 1 drives oscillator pitch; OUT 2 changes filter color; PULSE supplies 20 ms gates."
    ]
  },
  "description": {
    "sound": [
      "Short bright chirps jump between pitches while the filter changes color and a fast LFO makes each tone wobble. The result should suggest an animated machine trying urgently to explain something."
    ],
    "setup": [
      "Make the five numbered connections. Five dashed routes are built in and need no cables; the headphone lead is separate. Select Sequencer mode, start with output volume low, then press A.",
      "Set the marked controls before raising the output. If the sound is dull, open cutoff; if it whistles continuously, reduce resonance or Filter CV2."
    ],
    "play": [
      "Turn Brain X to change speaking speed and Z to move between repeated phrases and scattered chatter. Move LFO RATE from fast warble toward audio rate for sharper metallic vowels.",
      "Use VCO 1 FINE as a voice control. Small movements shift the whole character without changing the programmed sequence."
    ],
    "variations": [
      "Raise envelope decay for longer whistles. Increase Brain Y for wider leaps. Remove cable 5 for cleaner tones, or reduce LFO amount when the pitch becomes too seasick."
    ]
  },
  "normalled_policy": "N1-N5 retain the built-in VCO 1-to-mixer, mixer-to-filter, filter-to-VCA 1, ENV 1-to-control, and VCA 1-to-output audio chain. The five physical cables supply pitch, gate, two filter movements, and oscillator FM.",
  "external": {
    "external.headphones": {
      "label": "Stereo headphones",
      "direction": "in",
      "x": 522,
      "y": 852
    }
  },
